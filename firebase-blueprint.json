{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer order record across production, dispatch, and installation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "companyName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "gst": { "type": "string" },
        "amount": { "type": "string" },
        "status": { "type": "string" },
        "items": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerName", "mobileNumber"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Commercial quotation created for a buyer with category-specific product items.",
      "type": "object",
      "properties": {
        "quotationNo": { "type": "string", "maxLength": 64 },
        "quotationDate": { "type": "string", "maxLength": 32 },
        "validTillDate": { "type": "string", "maxLength": 32 },
        "buyerName": { "type": "string", "maxLength": 150 },
        "mobileNumber": { "type": "string", "maxLength": 40 },
        "companyName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 160 },
        "gstNumber": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 500 },
        "subtotal": { "type": "number" },
        "discountTotal": { "type": "number" },
        "gstRate": { "type": "number" },
        "gstAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentTerms": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["draft", "sent", "approved", "converted"] },
        "createdBy": { "type": "string", "maxLength": 160 },
        "signedByName": { "type": "string", "maxLength": 160 },
        "signedByEmail": { "type": "string", "maxLength": 160 },
        "signedByRole": { "type": "string", "maxLength": 64 },
        "signedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quotationNo", "buyerName", "mobileNumber", "grandTotal", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product record with specifications, variants, and compact primary thumbnail.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 120 },
        "price": { "type": "string", "maxLength": 64 },
        "thumbnailData": { "type": "string", "maxLength": 350000 },
        "hasVariants": { "type": "boolean" },
        "mediaSyncedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name"]
    },
    "ProductMedia": {
      "title": "ProductMedia",
      "description": "Cloud-persisted product gallery, variant, or 360 image stored in subcollection under 1MB limit.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["primary", "gallery", "variant", "spin360"] },
        "dataUrl": { "type": "string", "maxLength": 750000 },
        "variantId": { "type": "string", "maxLength": 128 },
        "index": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "dataUrl"]
    },
    "RawMaterial": {
      "title": "RawMaterial",
      "description": "Raw material inventory item with specifications, bill reference, and custom identification name.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "identificationName": { "type": "string", "maxLength": 200 },
        "sku": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 120 },
        "specs": { "type": "string", "maxLength": 1000 },
        "availableQuantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 40 },
        "unitCost": { "type": "number" },
        "colorCode": { "type": "string", "maxLength": 120 },
        "colorName": { "type": "string", "maxLength": 120 },
        "challanOrPoNo": { "type": "string", "maxLength": 120 },
        "receivedFrom": { "type": "string", "maxLength": 200 },
        "invoiceDate": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "category", "availableQuantity"]
    },
    "InventoryHistory": {
      "title": "InventoryHistory",
      "description": "Stock movement ledger entry for inward bills and project dispatches.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "materialId": { "type": "string", "maxLength": 128 },
        "materialName": { "type": "string", "maxLength": 200 },
        "identificationName": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["RECEIVED", "DISPATCHED", "ADJUSTMENT"] },
        "quantity": { "type": "number" },
        "challanOrPoNo": { "type": "string", "maxLength": 120 },
        "receivedFrom": { "type": "string", "maxLength": 200 },
        "billDate": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "materialId", "materialName", "type", "quantity"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Customer commercial quotations created from Quotations or Storefront portals"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products displayed in Products and Storefront tabs"
    },
    "/products/{productId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/ProductMedia" },
      "description": "Subcollection storing full-resolution product, gallery, and variant images across devices"
    },
    "/raw_materials/{materialId}": {
      "schema": { "$ref": "#/entities/RawMaterial" },
      "description": "Raw material inventory items and identification tags"
    },
    "/inventory_history/{historyId}": {
      "schema": { "$ref": "#/entities/InventoryHistory" },
      "description": "Inventory inward bill and project dispatch movement ledger"
    }
  }
}
